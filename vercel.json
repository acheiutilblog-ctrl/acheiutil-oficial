{
  "version": 2,
  "framework": "vite",
  "headers": [
    {
      "source": "/(feed|feed.xml|rss|rss.xml)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/rss+xml; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=1800, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/(sitemap.xml|sitemap_index.xml)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=7200"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/feed",
      "destination": "/feed.xml"
    },
    {
      "source": "/rss",
      "destination": "/rss.xml"
    },
    {
      "source": "/((?!assets/|products/|data/|favicon.*|feed|feed.xml|rss|rss.xml|sitemap.xml|robots.txt).*)",
      "destination": "/index.html"
    }
  ]
}
