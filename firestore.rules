rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidProduct(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 300
        && data.category is string && data.category.size() > 0 && data.category.size() <= 50
        && data.price is number && data.price >= 0
        && data.affiliateUrl is string && data.affiliateUrl.size() > 0 && data.affiliateUrl.size() <= 2000;
    }

    // Products catalog is publicly readable by all site visitors
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isValidId(productId) && isValidProduct(request.resource.data);
      allow delete: if isValidId(productId);
    }

    // Site settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
